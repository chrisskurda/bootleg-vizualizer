{
  "name": "Cover Mirror",
  "description": "Kaleidoscope cut from the cover. The art slowly rotates and orbits inside mirrored wedges, ringed by a colour-matched spectrum.",
  "type": "native",
  "width": 1920,
  "height": 1080,
  "loopSeconds": 24,
  "params": {
    "wedges": {
      "type": "select",
      "label": "Wedges",
      "options": [
        "4",
        "6",
        "8",
        "12"
      ],
      "default": "6"
    },
    "react": {
      "type": "number",
      "label": "Zoom reactivity",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    "ring": {
      "type": "bool",
      "label": "Spectrum ring",
      "default": true
    }
  }
}