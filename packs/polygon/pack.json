{
  "name": "Wire Orbit",
  "description": "Rotating vector solids over a scrolling horizon grid with a spectrum scope. Arcade cabinet look.",
  "type": "native",
  "width": 1920,
  "height": 1080,
  "loopSeconds": 20,
  "params": {
    "palette": {
      "type": "select",
      "label": "Palette",
      "options": [
        "aurora",
        "sunset",
        "neon",
        "ember",
        "ocean",
        "mono",
        "candy"
      ],
      "default": "aurora"
    },
    "bg": {
      "type": "color",
      "label": "Background",
      "default": "#000806"
    },
    "scan": {
      "type": "number",
      "label": "Scanlines",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "glow": {
      "type": "number",
      "label": "Phosphor glow",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  }
}