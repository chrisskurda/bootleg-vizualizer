{
 "name": "Spectrum: LED Matrix",
 "page": "index.html",
 "type": "native",
 "width": 1920,
 "height": 1080,
 "loopSeconds": 60,
 "description": "48x22 LED grid with palette zones and falling peak dots.",
 "params": {
  "palette": {
   "type": "select",
   "label": "Palette",
   "options": [
    "aurora",
    "sunset",
    "neon",
    "ember",
    "ocean",
    "mono",
    "candy"
   ],
   "default": "ember"
  },
  "bg": {
   "type": "color",
   "label": "Background",
   "default": "#08080c"
  },
  "cols": {
   "type": "number",
   "label": "Columns",
   "default": 48,
   "min": 16,
   "max": 64,
   "step": 1
  },
  "rows": {
   "type": "number",
   "label": "Rows",
   "default": 22,
   "min": 8,
   "max": 32,
   "step": 1
  },
  "gap": {
   "type": "number",
   "label": "Gap",
   "default": 0.28,
   "min": 0.1,
   "max": 0.5,
   "step": 0.02
  }
 }
}