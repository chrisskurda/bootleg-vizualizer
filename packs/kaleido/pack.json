{
  "name": "Kaleidoscope",
  "description": "Mirrored wedge kaleidoscope of drifting glass shapes; spectrum scales the pieces.",
  "type": "native",
  "width": 1920,
  "height": 1080,
  "loopSeconds": 20,
  "params": {
    "palette": {
      "type": "select",
      "label": "Palette",
      "options": [
        "aurora",
        "sunset",
        "neon",
        "ember",
        "ocean",
        "mono",
        "candy"
      ],
      "default": "candy"
    },
    "bg": {
      "type": "color",
      "label": "Background",
      "default": "#06040e"
    },
    "segments": {
      "type": "select",
      "label": "Segments",
      "options": [
        "6",
        "8",
        "10",
        "12"
      ],
      "default": "8"
    }
  }
}