{
  "name": "Desktop",
  "description": "Vaporwave: retro OS windows with block spectrum, scope and now-playing.",
  "type": "native",
  "width": 1920,
  "height": 1080,
  "loopSeconds": 20,
  "params": {
    "palette": {
      "type": "select",
      "label": "Palette",
      "options": [
        "aurora",
        "sunset",
        "neon",
        "ember",
        "ocean",
        "mono",
        "candy",
        "vapor"
      ],
      "default": "vapor"
    },
    "bg": {
      "type": "color",
      "label": "Background",
      "default": "#008080"
    }
  }
}