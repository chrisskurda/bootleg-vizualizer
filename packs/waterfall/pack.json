{
  "name": "Waterfall",
  "description": "Vertical spectrogram terrain built from A.past(), receding to a pulsing sun.",
  "type": "native",
  "width": 1080,
  "height": 1920,
  "loopSeconds": 12,
  "params": {
    "palette": { "type": "select", "label": "Palette", "options": ["aurora", "sunset", "neon", "ember", "ocean", "mono", "candy"], "default": "sunset" },
    "bg": { "type": "color", "label": "Background", "default": "#12060f" },
    "height": { "type": "number", "label": "Ridge height", "default": 1, "min": 0.4, "max": 1.5, "step": 0.05 },
    "sun": { "type": "bool", "label": "Sun", "default": true }
  }
}
