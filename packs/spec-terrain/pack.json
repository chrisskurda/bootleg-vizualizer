{
 "name": "Spectrum: Terrain",
 "page": "index.html",
 "type": "native",
 "width": 1920,
 "height": 1080,
 "loopSeconds": 60,
 "description": "Joy-Division style ridge lines receding in time (waterfall).",
 "params": {
  "palette": {
   "type": "select",
   "label": "Palette",
   "options": [
    "aurora",
    "sunset",
    "neon",
    "ember",
    "ocean",
    "mono",
    "candy"
   ],
   "default": "mono"
  },
  "bg": {
   "type": "color",
   "label": "Background",
   "default": "#05060d"
  },
