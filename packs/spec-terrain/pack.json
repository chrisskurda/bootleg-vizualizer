   "type": "number",
   "label": "Rows",
   "default": 34,
   "min": 12,
   "max": 60,
   "step": 1
  },
  "step": {
   "type": "number",
   "label": "Row spacing (sec)",
   "default": 0.1,
   "min": 0.04,
   "max": 0.25,
   "step": 0.01
  },
  "height": {
   "type": "number",
   "label": "Peak height",
   "default": 190,
   "min": 60,
   "max": 320,
   "step": 5
  }
 }
}