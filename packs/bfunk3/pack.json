{
  "name": "Business Funk III: Black Monday",
  "page": "index.html",
  "type": "native",
  "width": 1920,
  "height": 1080,
  "loopSeconds": 90,
  "description": "Glitched market-crash terminal. The index falls across the song while eight charts (index, candles, trading halt, order book, ticker wall, heat map, seismograph, heart rate) tear, split and flicker harder as it drops. Beats flash red.",
  "params": {
    "palette": {
      "type": "select",
      "label": "Palette",
      "options": [
        "Terminal",
        "Amber",
        "Fax"
      ],
      "default": "Terminal"
    },
    "glitch": {
      "type": "number",
      "label": "Glitch amount",
      "default": 1,
      "min": 0,
      "max": 1.5,
      "step": 0.1
    },
    "gain": {
      "type": "number",
      "label": "Gain",
      "default": 1,
      "min": 0.5,
      "max": 1.6,
      "step": 0.05
    },
    "cycle": {
      "type": "select",
      "label": "Scene changes",
      "options": [
        "auto",
        "fixed",
        "beats",
        "sections"
      ],
      "default": "auto"
    },
    "sceneBeats": {
      "type": "number",
      "label": "Beats per scene",
      "default": 16,
      "min": 4,
      "max": 64,
      "step": 4
    },
    "scenes": {
      "type": "multi",
      "label": "Scenes (pick one to hold it)",
      "options": [
        "Index",
        "Candles",
        "Halt",
        "Book",
        "Wall",
        "Heat",
        "Seismo",
        "Pulse"
      ],
      "default": [
        "Index",
        "Candles",
        "Halt",
        "Book",
        "Wall",
        "Heat",
        "Seismo",
        "Pulse"
      ]
    },
    "showMeta": {
      "type": "bool",
      "label": "Show song info",
      "default": true
    }
  }
}
